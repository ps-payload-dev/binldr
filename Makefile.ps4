PLATFORM := ps4
PS4_PAYLOAD_SDK ?= /opt/ps-payload-sdk/ps4
ELFLDR_REPO ?= https://github.com/ps-payload-dev/elfldr.git
PTRACE_REPO ?= https://github.com/ps-payload-dev/lib-ptrace.git
DEPS_DIR ?= deps
ELFLDR_DIR ?= $(DEPS_DIR)/elfldr
PTRACE_DIR ?= $(DEPS_DIR)/lib-ptrace
BUILD_DIR ?= build
OBJ_DIR := $(BUILD_DIR)/objects

ELFLDR_HEADERS := headers
ELFLDR_SOURCE_ROOT := source
ELFLDR_BIN := $(ELFLDR_DIR)/build/ps4/elfldr-ps4.bin
ELFLDR_NOTIFY := $(ELFLDR_DIR)/$(ELFLDR_SOURCE_ROOT)/shared/notify.c
BINRUNNER := $(OBJ_DIR)/binrunner.elf
PTRACE_CHECKOUT := $(PTRACE_DIR)/.git
PTRACE_LIB := $(PTRACE_DIR)/build/ps4/libptrace.a

include $(PS4_PAYLOAD_SDK)/toolchain/orbis.mk
include Makefile.build

BOOT_ELF := $(PAYLOAD)

# BIN bootstrapper: a flat x86-64 image that maps $(BOOT_ELF) into memory,
# applies its relative relocations and jumps to its entry point
BOOT_BIN := $(BOOT_ELF:.elf=.bin)
BOOT_DIR := $(BUILD_DIR)/bootstrap

all: $(BOOT_BIN)

$(BOOT_DIR)/bin.o: source/bootstrap-bin.c $(BOOT_ELF)
	@mkdir -p $(dir $@)
	$(CC) -O2 -fPIC -fno-stack-protector -fno-builtin -Wall -Werror 	    -DBOOT_ELF=\"$(BOOT_ELF)\" -c -o $@ $<

$(BOOT_DIR)/bin.elf: $(BOOT_DIR)/bin.o source/bin_x86_64.x
	$(LD) -T source/bin_x86_64.x -o $@ $<

$(BOOT_BIN): $(BOOT_DIR)/bin.elf
	$(OBJCOPY) -O binary --only-section=.text $< $@
